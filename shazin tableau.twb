      <table>
        <view>
          <datasources>
            <datasource caption='project_Tableau shazin' name='federated.0vty4ft0zlrmn51fkvxt31lu60fk' />
          </datasources>
          <datasource-dependencies datasource='federated.0vty4ft0zlrmn51fkvxt31lu60fk'>
            <column caption='Beginning Value' datatype='integer' name='[Calculation_0654277039226883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [state] :&#13;&#10;SUM(&#13;&#10;IF [date (state wise data)] &gt;= #2021-04-01#&#13;&#10;AND [date (state wise data)] &lt; #2022-04-01#&#13;&#10;THEN [total_vehicles_sold]&#13;&#10;END&#13;&#10;)&#13;&#10;}' />
            </column>
            <column caption='Ending Value' datatype='integer' name='[Calculation_0654277039521796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [state] :&#13;&#10;SUM(&#13;&#10;IF [date (state wise data)] &gt;= #2023-04-01#&#13;&#10;AND [date (state wise data)] &lt; #2024-04-01#&#13;&#10;THEN [total_vehicles_sold]&#13;&#10;END&#13;&#10;)&#13;&#10;}' />
            </column>
            <column caption='CAGR calculation' datatype='real' name='[Calculation_0654277040009221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_0654277039226883] &gt; 0&#13;&#10;AND [Calculation_0654277039521796] &gt; 0&#13;&#10;THEN&#13;&#10;POWER(&#13;&#10;[Calculation_0654277039521796] / [Calculation_0654277039226883],&#13;&#10;1.0 / 2&#13;&#10;) - 1&#13;&#10;END' />
            </column>
            <column caption='Date (State Wise Data)' datatype='date' name='[date (state wise data)]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0654277040009221]' derivation='Min' name='[min:Calculation_0654277040009221:qk]' pivot='key' type='quantitative' />
            <column-instance column='[state]' derivation='None' name='[none:state:nk]' pivot='key' type='nominal' />
            <column caption='State' datatype='string' name='[state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[Calculation_0654277040009221]' derivation='Sum' name='[sum:Calculation_0654277040009221:qk]' pivot='key' type='quantitative' />
            <column caption='Total Vehicles Sold' datatype='integer' name='[total_vehicles_sold]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0vty4ft0zlrmn51fkvxt31lu60fk].[none:state:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([Calculation_0654277040009221])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:state:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
