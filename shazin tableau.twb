    <worksheet name='Sheet 15'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Aptos,sans-serif'>Illustrative FY 2030 EV sales projections</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='project_Tableau shazin' name='federated.0vty4ft0zlrmn51fkvxt31lu60fk' />
          </datasources>
          <datasource-dependencies datasource='federated.0vty4ft0zlrmn51fkvxt31lu60fk'>
            <column caption='Beginning EV Sales' datatype='integer' name='[Calculation_0654277047246855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED :&#13;&#10;    SUM(&#13;&#10;        IF [date (state wise data)] &gt;= #2021-04-01#&#13;&#10;        AND [date (state wise data)] &lt; #2022-04-01#&#13;&#10;        THEN [electric_vehicles_sold]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Ending EV Sales' datatype='integer' name='[Calculation_0654277047472136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED :&#13;&#10;    SUM(&#13;&#10;        IF [date (state wise data)] &gt;= #2023-04-01#&#13;&#10;        AND [date (state wise data)] &lt; #2024-04-01#&#13;&#10;        THEN [electric_vehicles_sold]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='EV CAGR' datatype='real' name='[Calculation_0654277047603209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_0654277047246855] &gt; 0 THEN&#13;&#10;(&#13;&#10;    [Calculation_0654277047472136] / [Calculation_0654277047246855]&#13;&#10;) ^ (1.0 / 2) - 1&#13;&#10;END' />
            </column>
            <column caption='FY2030 Projected EV Sales' datatype='real' name='[Calculation_0654277047721994]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0654277047472136] *&#13;&#10;POWER(1 + [Calculation_0654277047603209], 6)' />
            </column>
            <column caption='Date (State Wise Data)' datatype='date' name='[date (state wise data)]' role='dimension' type='ordinal' />
            <column caption='Electric Vehicles Sold' datatype='integer' name='[electric_vehicles_sold]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0654277047472136]' derivation='Sum' name='[sum:Calculation_0654277047472136:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0654277047721994]' derivation='Sum' name='[sum:Calculation_0654277047721994:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0vty4ft0zlrmn51fkvxt31lu60fk].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0vty4ft0zlrmn51fkvxt31lu60fk].[sum:Calculation_0654277047472136:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0vty4ft0zlrmn51fkvxt31lu60fk].[sum:Calculation_0654277047721994:qk]&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0vty4ft0zlrmn51fkvxt31lu60fk].[:Measure Names]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
