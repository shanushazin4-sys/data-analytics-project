    <worksheet name='Sheet 7'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Courier New' fontsize='9'>FY-wise EV Sales Trend</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='project_Tableau shazin' name='federated.0vty4ft0zlrmn51fkvxt31lu60fk' />
          </datasources>
          <datasource-dependencies datasource='federated.0vty4ft0zlrmn51fkvxt31lu60fk'>
            <column caption='FY EV Sales' datatype='integer' name='[Calculation_0192205167919115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([electric_vehicles_sold])' />
            </column>
            <column caption='FY Sort' datatype='integer' name='[Calculation_0192205168640012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='YEAR([date]) +&#13;&#10;IF MONTH([date]) &gt;= 4 THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Financial Year' datatype='string' name='[Calculation_0192205169770510]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([date]) &gt;= 4 THEN&#13;&#10;    &quot;FY &quot; + STR(YEAR([date])) + &quot;-&quot; +&#13;&#10;    STR(YEAR([date]) + 1)&#13;&#10;ELSE&#13;&#10;    &quot;FY &quot; + STR(YEAR([date]) - 1) + &quot;-&quot; +&#13;&#10;    STR(YEAR([date]))&#13;&#10;END' />
            </column>
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Electric Vehicles Sold' datatype='integer' name='[electric_vehicles_sold]' role='measure' type='quantitative' />
            <column caption='Fiscal Year' datatype='integer' name='[fiscal_year]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_0192205169770510]' derivation='None' name='[none:Calculation_0192205169770510:nk]' pivot='key' type='nominal' />
            <column-instance column='[fiscal_year]' derivation='None' name='[none:fiscal_year:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vehicle_category]' derivation='None' name='[none:vehicle_category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0192205168640012]' derivation='Sum' name='[sum:Calculation_0192205168640012:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0192205167919115]' derivation='User' name='[usr:Calculation_0192205167919115:qk]' pivot='key' type='quantitative' />
