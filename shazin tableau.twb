      <aliases enabled='yes' />
      <column caption='CAGR %' datatype='real' name='[Calculation_0082255769612289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    POWER(&#13;&#10;        SUM(&#13;&#10;            IF YEAR([date (sales by maker)]) = 2024&#13;&#10;            THEN [electric_vehicles_sold]&#13;&#10;            END&#13;&#10;        )&#13;&#10;        /&#13;&#10;        SUM(&#13;&#10;            IF YEAR([date (sales by maker)]) = 2022&#13;&#10;            THEN [electric_vehicles_sold]&#13;&#10;            END&#13;&#10;        ),&#13;&#10;        1.0 / 3&#13;&#10;    ) - 1&#13;&#10;) * 100' />
      </column>
      <column caption='Total EV Sales' datatype='integer' name='[Calculation_0192205155098624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([electric_vehicles_sold])' />
      </column>
      <column caption='2 Wheeler EV Sales' datatype='integer' name='[Calculation_0192205155405825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [vehicle_category] = &quot;2-Wheelers&quot;&#13;&#10;THEN [electric_vehicles_sold]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='EV Penetration' datatype='real' name='[Calculation_0192205155713026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([electric_vehicles_sold])&#13;&#10;/&#13;&#10;SUM([total_vehicles_sold])' />
      </column>
      <column caption='4 Wheeler EV Sales' datatype='integer' name='[Calculation_0192205157548035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [vehicle_category] = &quot;4-Wheelers&quot;&#13;&#10;THEN [electric_vehicles_sold]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Financial Year 1' datatype='integer' name='[Calculation_0192205158223877]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MONTH([date]) &gt;= 4 THEN&#13;&#10;    YEAR([date]) + 1&#13;&#10;ELSE&#13;&#10;    YEAR([date])&#13;&#10;END' />
      </column>
      <column caption='State EV Penetration' datatype='real' name='[Calculation_0192205162565638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([electric_vehicles_sold])&#13;&#10;/&#13;&#10;SUM([total_vehicles_sold])' />
      </column>
      <column caption='Month Name' datatype='string' name='[Calculation_0192205164564487]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [date])' />
      </column>
      <column caption='Month Number' datatype='integer' name='[Calculation_0192205164744712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [date])' />
      </column>
      <column caption='Monthly EV Sales' datatype='integer' name='[Calculation_0192205165178890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([electric_vehicles_sold])' />
      </column>
      <column caption='FY EV Sales' datatype='integer' name='[Calculation_0192205167919115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([electric_vehicles_sold])' />
      </column>
      <column caption='FY Sort' datatype='integer' name='[Calculation_0192205168640012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([date]) +&#13;&#10;IF MONTH([date]) &gt;= 4 THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Financial Year' datatype='string' name='[Calculation_0192205169770510]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF MONTH([date]) &gt;= 4 THEN&#13;&#10;    &quot;FY &quot; + STR(YEAR([date])) + &quot;-&quot; +&#13;&#10;    STR(YEAR([date]) + 1)&#13;&#10;ELSE&#13;&#10;    &quot;FY &quot; + STR(YEAR([date]) - 1) + &quot;-&quot; +&#13;&#10;    STR(YEAR([date]))&#13;&#10;END' />
      </column>
      <column caption='Manufacturer Rank' datatype='integer' name='[Calculation_0292536309383168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK([Calculation_0192205155405825], &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='ev pendration rate ' datatype='integer' name='[Calculation_0376098129584128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_vehicles_sold])*100' />
      </column>
      <column caption=' Total EV Sales' datatype='integer' name='[Calculation_0376098130337793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([electric_vehicles_sold])' />
      </column>
      <column caption='Total Vehicle Sales' datatype='integer' name='[Calculation_0376098130624514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_vehicles_sold])' />
      </column>
      <column caption='estimate revenue ' datatype='real' name='[Calculation_0376098131574787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LAST() = FIRST() THEN NULL&#13;&#10;ELSE&#13;&#10;(&#13;&#10;    SUM([electric_vehicles_sold])&#13;&#10;    /&#13;&#10;    LOOKUP(SUM([electric_vehicles_sold]), FIRST())&#13;&#10;)&#13;&#10;^ (1.0 / (LAST() - FIRST())) - 1&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Previous Year Penetration' datatype='real' name='[Calculation_0654277035798528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP([Calculation_0192205155713026]) -1'>
          <table-calc ordering-field='' ordering-type='Field' tc-options='Fixed'>
            <address />
          </table-calc>
        </calculation>
      </column>
      <column caption='Penetration Change' datatype='real' name='[Calculation_0654277036081153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0192205155713026] - [Calculation_0654277035798528]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='negative states' datatype='string' name='[Calculation_0654277036224514]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0654277036081153] &lt; 0&#13;&#10;THEN &quot;Negative Change&quot;&#13;&#10;ELSE &quot;Positive / No Change&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Beginning Value' datatype='integer' name='[Calculation_0654277039226883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [state] :&#13;&#10;SUM(&#13;&#10;IF [date (state wise data)] &gt;= #2021-04-01#&#13;&#10;AND [date (state wise data)] &lt; #2022-04-01#&#13;&#10;THEN [total_vehicles_sold]&#13;&#10;END&#13;&#10;)&#13;&#10;}' />
      </column>
      <column caption='Ending Value' datatype='integer' name='[Calculation_0654277039521796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [state] :&#13;&#10;SUM(&#13;&#10;IF [date (state wise data)] &gt;= #2023-04-01#&#13;&#10;AND [date (state wise data)] &lt; #2024-04-01#&#13;&#10;THEN [total_vehicles_sold]&#13;&#10;END&#13;&#10;)&#13;&#10;}' />
      </column>
      <column caption='CAGR calculation' datatype='real' name='[Calculation_0654277040009221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0654277039226883] &gt; 0&#13;&#10;AND [Calculation_0654277039521796] &gt; 0&#13;&#10;THEN&#13;&#10;POWER(&#13;&#10;[Calculation_0654277039521796] / [Calculation_0654277039226883],&#13;&#10;1.0 / 2&#13;&#10;) - 1&#13;&#10;END' />
      </column>
      <column caption='Beginning EV Sales' datatype='integer' name='[Calculation_0654277047246855]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    SUM(&#13;&#10;        IF [date (state wise data)] &gt;= #2021-04-01#&#13;&#10;        AND [date (state wise data)] &lt; #2022-04-01#&#13;&#10;        THEN [electric_vehicles_sold]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Ending EV Sales' datatype='integer' name='[Calculation_0654277047472136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    SUM(&#13;&#10;        IF [date (state wise data)] &gt;= #2023-04-01#&#13;&#10;        AND [date (state wise data)] &lt; #2024-04-01#&#13;&#10;        THEN [electric_vehicles_sold]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='EV CAGR' datatype='real' name='[Calculation_0654277047603209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0654277047246855] &gt; 0 THEN&#13;&#10;(&#13;&#10;    [Calculation_0654277047472136] / [Calculation_0654277047246855]&#13;&#10;) ^ (1.0 / 2) - 1&#13;&#10;END' />
      </column>
      <column caption='FY2030 Projected EV Sales' datatype='real' name='[Calculation_0654277047721994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0654277047472136] *&#13;&#10;POWER(1 + [Calculation_0654277047603209], 6)' />
      </column>
